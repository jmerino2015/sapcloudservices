# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS PÚBLICA EN LA NUBE (PostgreSQL)
# ==============================================================================
#
# Para conectar tu Portal SAP Fiori a una base de datos pública accesible desde
# cualquier lugar y realizar demostraciones públicas por Internet:
#
# Proveedores Cloud Gratuitos Recomendados:
# 1. Supabase (https://supabase.com) - Crear proyecto gratis -> Settings -> Database -> Connection string (URI)
# 2. Neon (https://neon.tech) - PostgreSQL Serverless gratuito e instantáneo
# 3. Render / Railway / Aiven (PostgreSQL en la nube)
#
# Formato de conexión estándar:
# DATABASE_URL=postgresql://[USUARIO]:[CONTRASEÑA]@[HOST]:[PUERTO]/[BASE_DATOS]?sslmode=require
#
# Ejemplo real Supabase:
# DATABASE_URL=postgresql://postgres.abcdefghijkl:MiClaveSegura123@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# ==============================================================================

PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Coloca aquí la URL de tu base de datos pública cuando la crees:
DATABASE_URL=
