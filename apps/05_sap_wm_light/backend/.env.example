# Entorno local de desarrollo
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wm_light
DB_USER=postgres
DB_PASS=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES=7d

# SAP OData Connection (S/4HANA o ECC con NetWeaver Gateway)
SAP_ODATA_URL=http://sapserver.empresa.com:8000/sap/opu/odata/sap
SAP_CLIENT=100
SAP_USER=WM_LIGHT
SAP_PASSWD=sap_password_here

# SAP Sync Schedule (cron expression)
SAP_SYNC_CRON=0 */6 * * *

# Logging
LOG_LEVEL=info
