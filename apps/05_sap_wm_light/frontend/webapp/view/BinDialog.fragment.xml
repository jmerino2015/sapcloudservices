<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Dialog id="binDialog" title="{dlg>/title}" contentWidth="400px">
    <content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
        <f:content>
          <Label text="{i18n>locationsLabelCode}" required="true" />
          <Input value="{dlg>/bin_code}" editable="{= !${dlg>/isEdit} }" placeholder="Ej: A-01-01" />

          <Label text="Tipo de Almacén" required="true" />
          <Select selectedKey="{dlg>/storage_type_id}" items="{st>/types}" change=".onTypeChange">
            <core:Item key="{st>id}" text="{st>code} - {st>name}" />
          </Select>

          <Label text="{i18n>locationsLabelSection}" required="true" />
          <Select selectedKey="{dlg>/storage_section_id}" items="{dlg>/currentSections}">
            <core:Item key="{dlg>id}" text="{dlg>code} - {dlg>name}" />
          </Select>

          <Label text="{i18n>locationsLabelType}" />
          <Select selectedKey="{dlg>/bin_type}">
            <core:Item key="STANDARD" text="Standard" />
            <core:Item key="BULK" text="Bulk" />
            <core:Item key="PICKING" text="Picking" />
            <core:Item key="STAGING" text="Staging" />
            <core:Item key="BLOCKED" text="Blocked" />
          </Select>

          <Label text="{i18n>locationsLabelMaxWeight}" />
          <Input value="{dlg>/max_weight}" type="Number" placeholder="0.00" />

          <Label text="{i18n>locationsLabelMaxVol}" />
          <Input value="{dlg>/max_volume}" type="Number" placeholder="0.00" />

          <Label text="{i18n>locationsLabelStatus}" />
          <Select selectedKey="{dlg>/status}">
            <core:Item key="ACTIVE" text="Activo" />
            <core:Item key="INACTIVE" text="Inactivo" />
          </Select>
        </f:content>
      </f:SimpleForm>
    </content>
    <buttons>
      <Button text="{i18n>btnSave}" type="Emphasized" press=".onSaveBin" />
      <Button text="{i18n>btnCancel}" type="Transparent" press=".onCancelBin" />
    </buttons>
  </Dialog>
</core:FragmentDefinition>
