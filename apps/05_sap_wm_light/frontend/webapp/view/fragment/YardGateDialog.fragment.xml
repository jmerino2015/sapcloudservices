<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:layout="sap.ui.layout">
  <Dialog title="Caseta de Puerta (Gatehouse)" contentWidth="450px">
    <content>
      <layout:VerticalLayout width="100%" class="sapUiContentPadding">
        
        <SegmentedButton selectedKey="{gate>/action}" width="100%" class="sapUiSmallMarginBottom">
          <items>
            <SegmentedButtonItem key="IN" text="Check-In (Entrada)" icon="sap-icon://sys-enter-2" />
            <SegmentedButtonItem key="OUT" text="Check-Out (Salida)" icon="sap-icon://sys-cancel-2" />
          </items>
        </SegmentedButton>

        <Label text="Puerta" />
        <Select selectedKey="{gate>/gate_code}" width="100%" items="{yard>/gates}">
          <core:Item key="{yard>code}" text="{yard>code} - {yard>description}" />
        </Select>

        <!-- Bloque Check-In -->
        <VBox visible="{= ${gate>/action} === 'IN' }" class="sapUiTinyMarginTop">
          <Label text="Cita Esperada" required="true" />
          <Select selectedKey="{gate>/appointment_id}" width="100%" items="{appts>/items}">
            <core:Item key="{appts>id}" text="{appts>appointment_num} - {appts>vehicle/license_plate} ({appts>operation_type})" />
          </Select>
        </VBox>

        <!-- Bloque Check-Out -->
        <VBox visible="{= ${gate>/action} === 'OUT' }" class="sapUiTinyMarginTop">
          <Label text="Vehículo a Retirar" required="true" />
          <Select selectedKey="{gate>/vehicle_id}" width="100%" items="{yard>/gates}">
            <core:Item key="{yard>currentVehicle/id}" text="{yard>currentVehicle/license_plate} (en {yard>code})" />
          </Select>
        </VBox>

      </layout:VerticalLayout>
    </content>
    <beginButton>
      <Button text="Registrar" type="Emphasized" press=".onSaveGate" />
    </beginButton>
    <endButton>
      <Button text="Cerrar" press=".onCloseGate" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
