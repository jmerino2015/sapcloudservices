# ─────────────────────────────────────────────────────────────
# SAP WM Light — Configuración de Producción (.env)
# Copia este archivo como '.env' en el VPS y rellena los datos.
# ─────────────────────────────────────────────────────────────

# Seguridad Base de Datos PostgreSQL (Contenedor local de Docker)
# Reemplaza esto con una contraseña robusta para la base de datos de producción
DB_PASS=CambiaEstaContrasenaPorUnaSuperSegura2026!

# JWT (JSON Web Token)
# Genera una clave secreta larga y aleatoria para firmar los tokens de sesión.
# Puedes generar una en Linux usando: openssl rand -hex 32
JWT_SECRET=reemplazar_con_un_hash_largo_y_seguro_de_produccion_1234567890

# Opciones de Expiración de Token
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES=7d

# Modo Demostración
# Si es true, algunas acciones destructivas o de configuración crítica estarán deshabilitadas.
DEMO_MODE=false

# ─────────────────────────────────────────────────────────────
# SAP OData Connection (Opcional — Dejar vacío para usar Mocks locales)
# Conexión directa a SAP ERP (S/4HANA o ECC con NetWeaver Gateway)
# ─────────────────────────────────────────────────────────────
SAP_ODATA_URL=
SAP_CLIENT=100
SAP_USER=WM_LIGHT
SAP_PASSWD=

# Programación de sincronización con SAP (Expresión Cron)
# Por defecto: Cada 6 horas
SAP_SYNC_CRON=0 */6 * * *

# ─────────────────────────────────────────────────────────────
# Seguridad y Ajustes de Servidor
# ─────────────────────────────────────────────────────────────
# Orígenes permitidos para CORS (en producción se puede limitar al subdominio del front, o dejar * si se usa proxy de Nginx)
ALLOWED_ORIGINS=*

# Nivel de logs (error, warn, info, debug)
LOG_LEVEL=info
