{
  "_version": "1.60.0",
  "sap.app": {
    "id": "fue.control",
    "type": "application",
    "title": "Control de FUE y Usuarios",
    "description": "Dashboard administrativo para el control de FUE y usuarios",
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true },
    "fullWidth": true
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "fue.control.view.App",
      "type": "XML"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.ui.layout": {},
        "sap.ui.core": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "resources": {
      "css": [
        { "uri": "css/style.css" }
      ]
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "fue.control.i18n.i18n" }
      },
      "app": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
          "data": {
            "sideNavExpanded": true,
            "currentView": "home",
            "user": {
              "name": "Administrador de Licencias",
              "initials": "AL"
            }
          }
        }
      },
      "fueModel": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
          "data": {
            "records": [],
            "pivot": [],
            "kpis": {
              "totalFUE": 0,
              "totalUsers": 0,
              "advancedFUE": 0,
              "coreFUE": 0,
              "developerFUE": 0,
              "selfServiceFUE": 0,
              "companiesCount": 0
            }
          }
        }
      }
    }
  }
}
