<mvc:View
    controllerName="com.antigravity.portalProveedores.controller.CreditNotes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:cssgrid="sap.ui.layout.cssgrid"
    xmlns:core="sap.ui.core">

    <Page id="creditNotesPage" title="Registro de Notas de Crédito (Devolución de Stock e Importe — Req. N° 1)" showNavButton="true" navButtonPress=".onNavBack">
        <headerContent>
            <Button text="➕ Registrar Nota de Crédito" icon="sap-icon://add" type="Emphasized" press=".onOpenCreditNoteDialog" />
        </headerContent>
        <content>
            <VBox class="sapUiSmallMargin">

                <!-- Header Info Panel -->
                <Panel headerText="Notas de Crédito por Devolución de Mercadería &amp; Ajustes de Importe (Req. N° 1 BPD)" class="sapUiSmallMarginBottom">
                    <VBox class="sapUiTinyMargin">
                        <Text text="Consulte y registre las Notas de Crédito (NC) emitidas por devolución de stock asociadas a los ingresos de Ordenes de Compra (OC):" class="sapUiSmallMarginBottom" />

                        <Table items="{app>/creditNotes}">
                            <columns>
                                <Column><Text text="Nro. Registro" /></Column>
                                <Column><Text text="Folio NC SUNAT" /></Column>
                                <Column><Text text="Modalidad (Stock / Importe)" /></Column>
                                <Column><Text text="Orden Compra (OC)" /></Column>
                                <Column><Text text="Nota Devolución Compras" /></Column>
                                <Column><Text text="Motivo Devolución" /></Column>
                                <Column><Text text="Monto Total NC" /></Column>
                                <Column><Text text="Asiento SAP" /></Column>
                                <Column><Text text="Estado" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem highlight="Success">
                                    <cells>
                                        <ObjectIdentifier title="{app>id}" />
                                        <Text text="{app>folioNc}" />
                                        <ObjectStatus text="{app>tipoNcNombre}" state="Information" icon="sap-icon://sales-quote" />
                                        <Text text="{app>ordenCompra}" />
                                        <ObjectStatus text="{app>notaDevolucion}" state="Warning" icon="sap-icon://supplier" />
                                        <Text text="{app>motivo}" />
                                        <ObjectNumber number="{app>montoTotal}" unit="{app>moneda}" state="Success" />
                                        <Text text="{app>asientoSap}" />
                                        <ObjectStatus text="{app>estado}" state="Success" icon="sap-icon://accept" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
