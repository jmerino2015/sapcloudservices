{
  "_version": "1.76.0",
  "sap.app": {
    "id": "c4c.leadmanagement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.20.0",
      "toolsId": "d0ffd410-8ed7-4d56-a1c8-90fe4305c53d"
    },
    "dataSources": {
      "leadsService": {
        "uri": "/sap/opu/odata/sap/ZGW_CRUD_LEADS_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      },
      "usuarioService": {
        "uri": "/sap/opu/odata/sap/ZGW_CRUD_INPUT_USUARIOS_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      },
      "direccionService": {
        "uri": "/sap/opu/odata/sap/ZGW_GET_DIRECCIONES_CLIENTES_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      },
      "monedaService": {
        "uri": "/sap/opu/odata/sap/ZGW_GET_MONEDA_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      },
      "listarClienteService": {
        "uri": "/sap/opu/odata/sap/ZGW_GET_CLIENT_C4C_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      },
      "orgVentasService": {
        "uri": "/sap/opu/odata/sap/ZGW_GET_ORG_VENTAS_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      },
      "canalDistService": {
        "uri": "/sap/opu/odata/sap/ZGW_GET_CANAL_DIST_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      },
      "paisService": {
        "uri": "/sap/opu/odata/sap/ZGW_GET_PAIS_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      },
      "regionService": {
        "uri": "/sap/opu/odata/sap/ZGW_GET_REGION_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.143.2",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {},
        "sap.ui.comp": {},
        "sap.ui.table": {},
        "sap.viz": {},
        "sap.suite.ui.microchart": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "c4c.leadmanagement.i18n.i18n"
        }
      },
      "leadsModel": {
        "dataSource": "leadsService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "usuarioModel": {
        "dataSource": "usuarioService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "direccionModel": {
        "dataSource": "direccionService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "monedaModel": {
        "dataSource": "monedaService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "listarClienteModel": {
        "dataSource": "listarClienteService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "orgVentasModel": {
        "dataSource": "orgVentasService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "canalDistModel": {
        "dataSource": "canalDistService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "paisModel": {
        "dataSource": "paisService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "regionModel": {
        "dataSource": "regionService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "c4c.leadmanagement.view",
        "async": true,
        "viewPath": "c4c.leadmanagement.view"
      },
      "routes": [
        {
          "name": "RouteMenu",
          "pattern": "",
          "target": [
            "TargetMenu"
          ]
        },
        {
          "name": "RouteMenuExplicit",
          "pattern": "Menu",
          "target": [
            "TargetMenu"
          ]
        },
        {
          "name": "RouteDashboard",
          "pattern": "Dashboard",
          "target": [
            "TargetDashboard"
          ]
        },
        {
          "name": "RoutePrePlan",
          "pattern": "PrePlanificacion",
          "target": [
            "TargetPrePlan"
          ]
        },
        {
          "name": "RouteSupplyChain",
          "pattern": "SupplyChain",
          "target": [
            "TargetSupplyChain"
          ]
        }
      ],
      "targets": {
        "TargetLogin": {
          "viewId": "Login",
          "viewName": "Login",
          "viewLevel": 0
        },
        "TargetPrePlan": {
          "viewId": "PrePlan",
          "viewName": "PrePlan",
          "viewLevel": 2
        },
        "TargetMenu": {
          "viewId": "Menu",
          "viewName": "Menu",
          "viewLevel": 1
        },
        "TargetDashboard": {
          "viewId": "Dashboard",
          "viewName": "Dashboard",
          "viewLevel": 2
        },
        "TargetSupplyChain": {
          "viewId": "SupplyChain",
          "viewName": "SupplyChain",
          "viewLevel": 2
        }
      }
    },
    "rootView": {
      "viewName": "c4c.leadmanagement.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "leadmanagement"
  }
}