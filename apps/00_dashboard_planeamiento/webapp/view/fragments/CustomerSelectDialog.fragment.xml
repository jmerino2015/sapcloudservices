<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <TableSelectDialog
        title="Seleccionar Cliente"
        noDataText="No se encontraron clientes"
        search="onCustomerSearch"
        confirm="onCustomerConfirm"
        cancel="onCustomerCancel"
        items="{selectionModel>/customers}">
        <ColumnListItem>
            <cells>
                <ObjectIdentifier title="{selectionModel>name}" text="{selectionModel>id}"/>
                <Text text="{selectionModel>city}" />
            </cells>
        </ColumnListItem>
        <columns>
            <Column>
                <header>
                    <Text text="Cliente" />
                </header>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true">
                <header>
                    <Text text="Ciudad" />
                </header>
            </Column>
        </columns>
    </TableSelectDialog>
</core:FragmentDefinition>