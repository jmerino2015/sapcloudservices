{
  "_version": "1.40.0",
  "sap.app": {
    "id": "com.droidconsulting.entregasRendir",
    "type": "application",
    "title": "Entregas a Rendir y Viáticos",
    "description": "Gestión de Rendición de Cuentas, Anticipos y Comprobantes de Pago",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://travel-expense"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.droidconsulting.entregasRendir.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.droidconsulting.entregasRendir.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "TargetMain",
          "pattern": "",
          "target": "TargetMain"
        }
      ],
      "targets": {
        "TargetMain": {
          "viewName": "Main",
          "viewId": "main"
        }
      }
    }
  }
}
