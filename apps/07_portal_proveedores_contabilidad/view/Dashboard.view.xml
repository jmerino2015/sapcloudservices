<mvc:View
    controllerName="com.antigravity.portalProveedoresContabilidad.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Page id="dashboardPage" showHeader="false">
        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Título Superior -->
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                    <VBox>
                        <Title text="Consola Ejecutiva — Cuentas por Pagar &amp; 3-Way Matching" level="H2" />
                        <Text text="Monitoreo en tiempo real de facturas pre-registradas, validaciones tributarias SUNAT y enlaces MM-FI" style="color:#64748b;" />
                    </VBox>
                    <Button text="Ir a Facturas &amp; Conciliación" icon="sap-icon://process" type="Emphasized" press=".onNavToInvoices" />
                </HBox>

                <!-- =======================================================
                     FRANJA SUPERIOR DE 4 TARJETAS KPI (ESTÁNDAR HORIZON)
                     Implementado con controles nativos SAPUI5 (VBox / Text)
                     ======================================================= -->
                <HBox wrap="Wrap" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                    <!-- KPI 1: Naranja / Coral (#e06a3b) -->
                    <VBox class="kpiCardHorizon sapUiSmallMarginEnd sapUiTinyMarginBottom" width="220px">
                        <Label text="FACTURAS PENDIENTES" class="kpiCardTitle" />
                        <Text text="14 / 28" class="kpiValueOrange" />
                        <Text text="Revisión Contable &amp; MIRO Pendiente" class="kpiSubLabel" />
                        <Button text="Revisar Facturas" icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onNavToInvoices" class="sapUiTinyMarginTop" />
                    </VBox>

                    <!-- KPI 2: Dark Slate (#1e293b) -->
                    <VBox class="kpiCardHorizon sapUiSmallMarginEnd sapUiTinyMarginBottom" width="220px">
                        <Label text="IMPORTE TOTAL PERIODO" class="kpiCardTitle" />
                        <Text text="$ 486,250.00" class="kpiValueSlate" />
                        <Text text="Cartera Total USD — Ejercicio 2026" class="kpiSubLabel" />
                        <Button text="Ver Cartera" icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onNavToInvoices" class="sapUiTinyMarginTop" />
                    </VBox>

                    <!-- KPI 3: Verde (#107e3e) -->
                    <VBox class="kpiCardHorizon sapUiSmallMarginEnd sapUiTinyMarginBottom" width="220px">
                        <Label text="EFICIENCIA 3-WAY MATCH" class="kpiCardTitle" />
                        <Text text="96.4%" class="kpiValueGreen" />
                        <Text text="Conciliación Automática PO vs MIGO" class="kpiSubLabel" />
                        <Button text="Ver Conciliación" icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onNavToInvoices" class="sapUiTinyMarginTop" />
                    </VBox>

                    <!-- KPI 4: Naranja / Coral (#e06a3b) -->
                    <VBox class="kpiCardHorizon sapUiTinyMarginBottom" width="220px">
                        <Label text="FACTURAS OBSERVADAS" class="kpiCardTitle" />
                        <Text text="3 Alertas" class="kpiValueOrange" />
                        <Text text="Discrepancias Tolerancia ±2%" class="kpiSubLabel" />
                        <Button text="Resolver Alertas" icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onNavToInvoices" class="sapUiTinyMarginTop" />
                    </VBox>
                </HBox>

                <!-- PANELES INFORMATIVOS Y MÉTRICAS DE DETRACCIÓN -->
                <Panel headerText="Resumen de Retenciones y Detracciones Banco de la Nación" class="sapUiSmallMarginBottom">
                    <HBox wrap="Wrap" justifyContent="SpaceAround" alignItems="Center">
                        <VBox alignItems="Center" class="sapUiSmallMargin">
                            <Text text="Monto Total Detracciones" style="font-weight:600; color:#64748b;" />
                            <Title text="S/ 48,920.00 PEN" level="H3" class="sapUiTinyMarginTop" />
                            <Text text="Cuentas Banco de la Nación Depuradas" style="font-size:11px; color:#107e3e;" />
                        </VBox>
                        <VBox alignItems="Center" class="sapUiSmallMargin">
                            <Text text="Retención IGV 3% Aplicable" style="font-weight:600; color:#64748b;" />
                            <Title text="$ 14,587.50 USD" level="H3" class="sapUiTinyMarginTop" />
                            <Text text="Certificados de Retención Emitidos" style="font-size:11px; color:#0a6ed1;" />
                        </VBox>
                        <VBox alignItems="Center" class="sapUiSmallMargin">
                            <Text text="Facturas Aprobadas SUNAT SIRE" style="font-weight:600; color:#64748b;" />
                            <Title text="25 de 28" level="H3" class="sapUiTinyMarginTop" />
                            <Text text="89.3% Validadas en Padrón SUNAT" style="font-size:11px; color:#107e3e;" />
                        </VBox>
                    </HBox>
                </Panel>

                <!-- ACCIONES RÁPIDAS CONTABLES -->
                <Panel headerText="Accesos Rápidos a Módulos Financieros">
                    <HBox wrap="Wrap" justifyContent="Start">
                        <Button text="Facturas Pre-Registradas" icon="sap-icon://customer-financial-fact-sheet" press=".onNavToInvoices" class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                        <Button text="Verificación Fiscal SUNAT / SIRE" icon="sap-icon://official-service" press=".onNavToSunatSire" class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                        <Button text="Contabilización SAP (MIRO)" icon="sap-icon://accounting-document-verification" press=".onNavToSapPosting" class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                        <Button text="Auditoría de Pagos &amp; Detracciones" icon="sap-icon://money-bills" press=".onNavToPaymentsAudit" class="sapUiSmallMarginEnd sapUiTinyMarginBottom" />
                    </HBox>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
