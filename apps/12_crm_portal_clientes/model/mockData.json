  "communityForums": [
    {
      "id": "POST-01",
      "title": "¿Cómo optimizar el consumo eléctrico en motores IE4 en régimen continuo?",
      "category": "Eficiencia Energética",
      "author": "Ing. Carlos Mendoza",
      "authorRank": "Master B2B",
      "date": "2026-09-01 14:30",
      "likes": 24,
      "repliesCount": 6,
      "solved": true,
      "content": "Hemos implementado variadores de frecuencia VFD en conjunto con los motores IE4 de 75kW, reduciendo la temperatura de operación en 12°C y el consumo en un 18%.",
      "comments": [
        { "author": "Rodrigo Silva (Especialista SAP)", "date": "2026-09-01 15:10", "text": "Excelente aporte Carlos. Recuerden ajustar la curva V/f para cargas de par cuadrático en bombas." },
        { "author": "Francisca Gómez", "date": "2026-09-01 16:00", "text": "¿Qué modelo de VFD utilizaron para faena minera?" }
      ]
    },
    {
      "id": "POST-02",
      "title": "Mejores prácticas para almacenamiento de rodamientos de gran diámetro en bodega",
      "category": "Mantenimiento Mecánico",
      "author": "Lucía Arismendi",
      "authorRank": "Especialista",
      "date": "2026-08-30 11:20",
      "likes": 18,
      "repliesCount": 3,
      "solved": false,
      "content": "Es fundamental almacenar los rodamientos en posición horizontal y sobre superficies aisladas de vibraciones externas para evitar el falso brinelling.",
      "comments": [
        { "author": "Marcos Rivera (QA Support)", "date": "2026-08-30 13:45", "text": "Totalmente de acuerdo. Además la humedad ambiente no debe superar el 60%." }
      ]
    }
